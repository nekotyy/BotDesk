{
  "name": "botdesk",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "description": "Desktop manager for Telegram bots and their conversations",
  "license": "MIT",
  "author": "nekotyy",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "icon:generate": "node scripts/generate-icon.mjs",
    "build:web": "tsc -b && vite build",
    "build": "npm run build:web && electron-builder --win nsis portable --x64 && electron-builder --win nsis portable --ia32",
    "lint": "oxlint src",
    "typecheck": "tsc -b --pretty false"
  },
  "build": {
    "appId": "app.botdesk.desktop",
    "productName": "BotDesk",
    "icon": "assets/icon.ico",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BotDesk",
      "artifactName": "BotDesk-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "BotDesk-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.32.0",
    "png-to-ico": "^3.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "wait-on": "^9.0.3"
  }
}
